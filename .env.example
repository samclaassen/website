# Canonical site URL (defaults to https://www.legacyhomeware.com)
NEXT_PUBLIC_SITE_URL=

# PromptWatch crawler logs (see src/proxy.ts). Optional.
PROMPTWATCH_LOGS_API_KEY=

# Search engine ownership verification (HTML-tag method). Paste the token only, not the
# whole tag. Set in Vercel → Environment Variables, then redeploy. Optional.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Newsletter ("The keeping list"). The signup form renders only when ONE of these is set
# (see src/lib/newsletter.ts). Set in Vercel, then redeploy. Optional.
BUTTONDOWN_API_KEY=
# or
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# or any endpoint that accepts a JSON POST {email, source, site, subscribedAt}
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_SECRET=

# IndexNow key; must match public/<key>.txt. Only needed to override the default in
# scripts/indexnow.mjs.
INDEXNOW_KEY=
