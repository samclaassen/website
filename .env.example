# Request form delivery — configure ONE option in Vercel → Project → Settings → Environment Variables.
# Option A: any endpoint that accepts a JSON POST (Formspree, Zapier, Make, a Slack workflow, a CRM webhook…)
FORM_WEBHOOK_URL=
# Option B: email via Resend (https://resend.com)
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=
# Optional: shown on the request form if delivery is not configured
NEXT_PUBLIC_CONTACT_EMAIL=

# Google Search Console HTML-tag verification token (content value only)
GOOGLE_SITE_VERIFICATION=
